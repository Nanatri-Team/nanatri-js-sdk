NANATRI_API_BASE_URL=https://api.yourdomain.com
# OIDC issuer (authorization server). Local backend: https://localhost:7141
NANATRI_AUTH_URL=https://auth.yourdomain.com
# Where this SDK is served. The sign-in callback is <origin>/auth/callback and must be registered
# for the nanatri-widget client on the backend. Local: https://localhost:5174
NANATRI_SDK_ORIGIN=https://js-widget.yourdomain.com
# The member dashboard: "View my wishlist" and redirect mode (/add) go here.
NANATRI_DASHBOARD_URL=https://app.yourdomain.com
